BRAIN_API_URL=https://brain-api.example.com
BRAIN_API_TOKEN=replace-with-sb-web-read-token-never-owner-token
BRAIN_OWNER_TOKEN=replace-with-owner-token-for-real-and-writes
BRAIN_TRACE_FILE=../data/eval-traces.json
AUTH_SECRET=replace-with-random-nextauth-secret
OWNER_USERNAME=ArtJack
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Multi-Zones: serve this app under /lab/brain on www.artjeck.com.
# Set both in the child zone's Vercel project. Leave unset for local dev (root).
NEXT_PUBLIC_BASE_PATH=/lab/brain
NEXTAUTH_URL=https://www.artjeck.com/lab/brain
