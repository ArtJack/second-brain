<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.artjeck.sb-web</string>

  <!-- All configuration and secrets come from the repo's gitignored .env,
       loaded by config.py's load_dotenv() relative to WorkingDirectory.
       Owner-auth variables (SB_WEB_OWNER_TOKEN) are deliberately absent:
       the public deployment must not carry an owner path. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/artjack/Projects/AI/projects/second-brain/.venv/bin/sb-web-api</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/artjack/Projects/AI/projects/second-brain</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Bind to the tailnet interface only: the public edge reaches this
         origin via the ifta-api tunnel connector on artjeck-oracle
         (ingress brain-api.artjeck.com -> this address). Process env wins
         over .env because load_dotenv() does not override. -->
    <key>SB_WEB_HOST</key>
    <string>100.81.78.74</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/artjack/Projects/AI/projects/second-brain/logs/web.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/artjack/Projects/AI/projects/second-brain/logs/web.err.log</string>
</dict>
</plist>
