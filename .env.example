# Default: talk DIRECTLY to a local Ollama (free, no key, both models warm).
# Copy to .env. Switch to .env.gateway for the Claude-quality path (see .env.gateway.example).
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.1:8b

# Store backend. Chroma is local/on-disk; qdrant uses the AI Lab vector DB.
SB_STORE=chroma
SB_DATA=./data/chroma
SB_MEMORY_DIR=./data/memory
SB_STATE_DB=./data/artjeck.sqlite3
SB_COLLECTION=second_brain
# Reference material (study texts, standards, other people's docs) kept out of
# the personal ranking, where it otherwise wins on volume. `sb ask --corpus
# reference` and the MCP ask tool's corpus argument address it.
SB_REFERENCE_COLLECTION=second_brain_reference
# Roots the MCP `ingest` tool may read from, os.pathsep-separated. That tool is
# reachable over the tailnet by anything holding SB_MCP_TOKEN, and paired with
# `recall` an unrestricted ingest is an arbitrary-file-read primitive. Defaults
# to the repo and SB_MEMORY_DIR.
SB_INGEST_ROOTS=

# Public web-demo collections. Keep anonymous writes disabled unless/until reviewed.
SB_WEB_PUBLIC_COLLECTION=second_brain_public
SB_WEB_NEUTRAL_COLLECTION=second_brain_neutral
SB_WEB_SANDBOX_ENABLED=0
# Web API auth. Set web/BRAIN_API_TOKEN to SB_WEB_READ_TOKEN, never the owner token.
SB_WEB_READ_TOKEN=
SB_WEB_OWNER_TOKEN=

# Required only when SB_STORE=qdrant.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Retrieval tuning (optional)
SB_CHUNK_SIZE=1200
SB_CHUNK_OVERLAP=150
SB_TOP_K=5
SB_HYBRID=1            # 1=vector+BM25 keyword fusion (default), 0=vector-only
